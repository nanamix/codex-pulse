{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "moduleResolution": "Bundler", "strict": true, "noEmit": true,
    "allowImportingTsExtensions": true, "skipLibCheck": true
  },
  "include": ["src/**/*.ts"], "exclude": ["src/**/*.test.ts"]
}
